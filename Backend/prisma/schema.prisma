datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DRIVER
  AGENT
  PASSENGER
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum QRStatus {
  ACTIVE
  REVOKED
  REPLACED
  EXPIRED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionChannel {
  CHAPA
  CASH
  BANK_TRANSFER
  AGENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model PassengerRequest {
  id String @id @default(uuid())

  passengerId String
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  assignedAdminId String?
  assignedAdmin   User?   @relation("AssignedPassengerRequests", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  approvedById String?
  approvedBy   User?   @relation("ApprovedPassengerRequests", fields: [approvedById], references: [id], onDelete: SetNull)

  reason    String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model User {
  id       String  @id @default(uuid())
  fullName String
  email    String? @unique
  phone    String  @unique
  password String
  role     Role
  photoUrl String?

  approved Boolean @default(false)

  // ✅ Who approved this user
  approvedBy     String?
  approvedByUser User?   @relation("ApprovedByRelation", fields: [approvedBy], references: [id])
  approvedUsers  User[]  @relation("ApprovedByRelation")

  // ✅ Who registered this user
  registeredBy              String?
  registeredByUser          User?              @relation("RegisteredByRelation", fields: [registeredBy], references: [id])
  registeredUsers           User[]             @relation("RegisteredByRelation")
  transacrionInitiated      Transaction[]      @relation("TransactionsInitiated")
  assignedPassengerRequests PassengerRequest[] @relation("AssignedPassengerRequests")
  approvedPassengerRequests PassengerRequest[] @relation("ApprovedPassengerRequests")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet        Wallet?
  passenger     Passenger?
  driver        Driver?
  agent         Agent?
  notifications Notification[]
}

model Passenger {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  qrCode         String?            @unique
  qrToken        String?            @unique
  qrCard         PhysicalCard?
  isDigital      Boolean            @default(true)
  requests       PassengerRequest[]
  tripPassengers TripPassenger[]
}

model Driver {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicles Vehicle[]
  Trip     Trip[]
}

model Agent {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  outletName String
}

model Vehicle {
  id          String  @id @default(uuid())
  driverId    String?
  driver      Driver? @relation(fields: [driverId], references: [id])
  plateNumber String  @unique
  capacity    Int?
  route       String?
  Trip        Trip[]
}

model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance   Float        @default(0.0)
  status    WalletStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions Transaction[]
}

model Transaction {
  id            String             @id @default(uuid())
  initiatedById String? // optional: actor
  initiatedBy   User?              @relation("TransactionsInitiated", fields: [initiatedById], references: [id])
  walletId      String
  wallet        Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          String
  channel       TransactionChannel
  status        TransactionStatus  @default(SUCCESS)

  amount          Float
  previousBalance Float
  newBalance      Float
  description     String?
  metadata        Json?
  reference       String  @unique

  createdBy     String?
  createdAt     DateTime        @default(now())
  TripPassenger TripPassenger[]
}

model PhysicalCard {
  id          String    @id @default(uuid())
  passengerId String    @unique
  passenger   Passenger @relation(fields: [passengerId], references: [id])
  status      QRStatus  @default(ACTIVE)
  issuedBy    String?
  printed     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Trip {
  id        String  @id @default(uuid())
  vehicleId String
  driverId  String
  route     String?

  startTime DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  tripPassengers TripPassenger[]
}

model TripPassenger {
  id String @id @default(uuid())

  tripId        String
  passengerId   String
  transactionId String?

  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passenger   Passenger    @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  boardedAt DateTime @default(now())
  fare      Float?
}
